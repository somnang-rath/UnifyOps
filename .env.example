# Copy to .env and fill in. Create the roles first: scripts/bootstrap.sql

# --- Database -------------------------------------------------------------
# Owner role. Used ONLY by migrations and drizzle-kit. Owns every table.
# Never used by the running app — see PLAN.en.md §9.
DATABASE_URL_OWNER="postgresql://unifyops_owner:CHANGEME@localhost:5432/unifyops"

# Application role. Non-owner, RLS is FORCED against it. Used by the app at
# runtime. This is the connection that must never be able to see across
# workspaces even if a query forgets its WHERE clause.
DATABASE_URL="postgresql://unifyops_app:CHANGEME@localhost:5432/unifyops"

# Platform operator (§18-12). Cross-tenant SELECT only, behind its own auth
# boundary. scripts/bootstrap.sql needs it to create the role.
#
# From slice 9 it is also REQUIRED BY THE JOB WORKER (`pnpm jobs`): "which
# outbox rows are undelivered" and "which companies exist, in which timezone"
# span workspaces, and no tenant scope can answer them. The role is read-only at
# the database, so the worker holding it cannot write anything anywhere —
# everything it writes goes through withActor on the app role instead. The web
# process still does not need it.
DATABASE_URL_OPERATOR="postgresql://unifyops_operator:CHANGEME@localhost:5432/unifyops"

# The pre-tenancy handshake role (slice 3). Signing in, creating an account,
# and exchanging an invitation token all happen before a workspace is known, so
# they cannot run on the app connection — every app-role policy is false when
# tenancy.workspace_id() is unset. This role reaches app_user, workspace, the
# auth_* tables and invitation, and nothing that says what a company is doing.
DATABASE_URL_IDENTITY="postgresql://unifyops_identity:CHANGEME@localhost:5432/unifyops"

# --- App ------------------------------------------------------------------
# Absolute links in email are built from this. The job worker needs it too and
# has no build step to inline it — without it a notification's deep link throws
# after the inbox row is written, which reads as "the bell moved but no mail
# arrived".
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email ----------------------------------------------------------------
# Unset in development: invitation and verification mail is written to the
# server log instead of sent, and the invitation row still records a delivery
# status so the members list shows the same states it will in production.
# Set both to send for real through Resend (§8).
# RESEND_API_KEY=""
# EMAIL_FROM="UnifyOps <no-reply@example.com>"

# --- Attachments (§8, §18-5) ----------------------------------------------
# S3-compatible object storage. Unset in development: uploads are written under
# .attachments/ and served back through the same route, so the whole §7.7 flow
# and `pnpm test:e2e` work with no cloud account. Set all four to use R2 (or
# MinIO — the driver speaks the S3 API, not an R2 one).
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="unifyops"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
