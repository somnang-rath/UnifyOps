# Copy to .env and fill in. Create the roles first: scripts/bootstrap.sql

# --- Database -------------------------------------------------------------
# Owner role. Used ONLY by migrations and drizzle-kit. Owns every table.
# Never used by the running app — see PLAN.en.md §9.
DATABASE_URL_OWNER="postgresql://unifyops_owner:CHANGEME@localhost:5432/unifyops"

# Application role. Non-owner, RLS is FORCED against it. Used by the app at
# runtime. This is the connection that must never be able to see across
# workspaces even if a query forgets its WHERE clause.
DATABASE_URL="postgresql://unifyops_app:CHANGEME@localhost:5432/unifyops"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
