NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Live collaboration server (Yjs / Hocuspocus, ADR 0001). Absolute ws:// URL —
# WebSocket upgrades bypass the Next.js proxy.
NEXT_PUBLIC_LIVE_URL=ws://localhost:3100

# Public Space app (ADR 0002). Used to build the shareable "Publish to Space"
# link on wiki pages.
NEXT_PUBLIC_SPACE_URL=http://localhost:3002
