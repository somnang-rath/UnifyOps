# API base URL used for server-side (SSR) fetches to the public endpoints.
# Server-to-server, so this is the internal address of the API (ADR 0002 §6).
API_URL=http://localhost:4000/api/v1

# Public-facing API URL (only needed if the app ever fetches from the browser).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

PORT=3002
