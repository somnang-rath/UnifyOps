# apps/live — Hocuspocus realtime server (Phase 2, ADR 0001)
# Three secrets MUST match apps/api exactly: JWT_ACCESS_SECRET, MONGODB_URI,
# LIVE_INTERNAL_TOKEN.

PORT=3100

# Shared with apps/api — used to LOCALLY verify the client JWT (no API round-trip
# for authentication). Must be identical to the API's JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_secret_xx

# Shared Mongo. The live server opens its own connection and owns the
# `yjsdocuments` collection. Must match the API's MONGODB_URI.
MONGODB_URI=mongodb://localhost:27017/prism

# Base URL of the API's versioned routes — used for the internal access GET and
# the snapshot-back PUT.
INTERNAL_API_URL=http://localhost:4000/api/v1

# Shared server-to-server secret sent as `x-internal-token` to the API's
# internal wiki endpoints. Must match the API's LIVE_INTERNAL_TOKEN (>=32 chars).
LIVE_INTERNAL_TOKEN=replace_with_at_least_32_characters_internal_zz

# Comma-separated WS Origin allowlist (web :3000, space :3002).
LIVE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
