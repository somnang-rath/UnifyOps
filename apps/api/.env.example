NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/prism
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_secret_xx
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_secret_yy
JWT_REFRESH_TTL=7d

# Email — all optional. Leave SMTP_HOST blank to skip delivery (events are logged only).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_FROM=UnifyOps <no-reply@yourdomain.com>

# Redis — optional. When set, report dispatch uses BullMQ (jobs persist across
# server restarts and are retried on failure). When absent, reports fall back to
# in-process dispatch (fast for small lists; lost on crash).
# Run locally: docker run -p 6379:6379 redis:7-alpine
# REDIS_URL=redis://localhost:6379

# Report scheduler timezone — hours added to UTC so a report's scheduled `hour`
# is interpreted as local wall-clock time. Default 7 (Cambodia / ICT, UTC+7),
# so "send at 08:00" fires at 08:00 local time, not 08:00 UTC.
# REPORT_TZ_OFFSET_HOURS=7
