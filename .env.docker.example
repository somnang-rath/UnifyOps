# Copy to `.env` next to docker-compose.yml and edit before running `docker compose up`.
# `docker compose` auto-loads this file.

# --- URLs ---
# Hit by the browser; must be reachable from the host machine.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Hit by the Next.js server (refresh-token proxy). Uses the compose network.
API_URL=http://api:4000/api/v1
# CORS allow-list for the API.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- Mongo ---
MONGODB_URI=mongodb://mongo:27017/prism

# --- JWT (REQUIRED — must be at least 32 chars each) ---
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_secret_xx
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_secret_yy
JWT_REFRESH_TTL=7d

# --- Email (optional; leave SMTP_HOST blank to skip delivery) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Prism <no-reply@yourdomain.com>
